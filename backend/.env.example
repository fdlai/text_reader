# Copy this file to .env (in this same backend folder) and fill it in.
# .env is git-ignored, so your password and API key stay on your computer.

# PostgreSQL connection. Replace YOUR_PASSWORD with your postgres user's password.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/text_reader

# Optional: only needed for the paid OpenAI voices.
OPENAI_API_KEY=
